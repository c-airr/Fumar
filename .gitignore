# build directories
build/
out/
.cache/

# compiled shaders (generated by glslc)
*.spv

# compilation artifacts
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exe
*.dll
*.so
*.dylib

# IDE / tooling
.vs/
# Editor state is per-user, but two files in here are project configuration:
# which extensions this project needs, and where clangd finds the compile
# database. Without them "Open in VS Code" hands somebody a text editor with
# every line underlined in red.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
CMakeUserPresets.json
compile_commands.json

# system
Thumbs.db
.DS_Store

# downloaded sample assets, not ours to redistribute
assets/

# distribution output
dist/

# editor layout, per-machine
*.ini

# saved scenes are per-user work, not source
scenes/

# AI
claude.md